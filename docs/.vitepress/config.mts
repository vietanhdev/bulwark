import { withMermaid } from "vitepress-plugin-mermaid";
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

// Canonical domain (not yet deployed — see AGENTS.md's current-status notes). Set here so
// the sitemap and social-preview tags are correct from day one instead of needing a
// find-and-replace once hosting is actually wired up.
const SITE_URL = "https://bulwark.nrl.ai";

// One designed 1200x630 social card per page (not a generic site-wide image), so links shared
// to Slack/Discord/Twitter get a real preview instead of a blank card. Cards are generated by
// `node scripts/generate-og.mjs` and live in public/og/<slug>.png.
//
// The slug is *derived* from the page path rather than listed in a hand-maintained map. The
// map this replaces is precisely how ten articles shipped with no card at all: they were
// added to the sidebar, nobody remembered the map, and because twitter:card is
// summary_large_image site-wide, a page with no og:image renders a *blank* card — strictly
// worse than having no tags. Deriving the slug means a new article is covered the moment its
// card exists, and `generate-og.mjs --check` fails the build if one doesn't.
const OG_FALLBACK = "home";
const OG_SLUG_OVERRIDES: Record<string, string> = { "index.md": "home" };

function ogSlugFor(relativePath: string): string {
  // The generated per-check pages share the checks index card.
  if (relativePath.startsWith("checks/")) relativePath = "checks/checks.md";
  const slug =
    OG_SLUG_OVERRIDES[relativePath] ??
    relativePath.replace(/\.md$/, "").split("/").pop() ??
    OG_FALLBACK;
  // Never point at a card that isn't on disk — an og:image 404 is as bad as none.
  const onDisk = fileURLToPath(
    new URL(`../public/og/${slug}.png`, import.meta.url),
  );
  return existsSync(onDisk) ? slug : OG_FALLBACK;
}

