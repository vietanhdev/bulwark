      { type: "application/ld+json" },
      JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "Bulwark",
        url: SITE_URL,
        description:
          "Documentation and downloads for Bulwark, an open-source security scanner for Linux, macOS and Windows.",
