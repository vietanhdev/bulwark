[Desktop Entry]
# Hardcoded rather than {{categories}} / {{comment}}: Tauri's single `category` can only say
# "Utility", which files Bulwark away from security tools in the app grid, and {{comment}} falls back
# to the Cargo package description — a developer note GNOME shows users as the tooltip.
Categories=System;Security;Utility;
Comment=Security for your dev machines, the servers they reach, and your AI coding tools
GenericName=Security Scanner
Keywords=security;scanner;hardening;audit;ssh;antivirus;monitoring;
Exec={{exec}}
# Load-bearing, and it is only correct by coincidence of {{exec}} == the binary
# name. GTK advertises the *binary name* as the Wayland app_id (measured with
# WAYLAND_DEBUG=1: xdg_toplevel.set_app_id("bulwark-app")), not tauri.conf.json's
# identifier and not this file's basename ("bulwark"). GNOME matches a window to
# its desktop entry on that string, so if this ever stops equalling the app_id
# the window loses its icon in the dash, alt-tab and the window list.
StartupWMClass={{exec}}
Icon={{icon}}
Name=Bulwark
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
